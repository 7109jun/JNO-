코드:
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JNO Studio</title>
<style>
/* ======================================================================
   JNO STUDIO — DESIGN TOKENS
   Identity: a "sealed container" — deep charcoal body, brass wax-seal
   accent for actions/security, cool cyan for raw binary/data elements.
   ====================================================================== */
:root{
  --bg-app:#14161c;
  --bg-panel:#1a1d25;
  --bg-elevated:#20232d;
  --bg-hover:#282c38;
  --bg-input:#171a22;
  --border:#2c303c;
  --border-soft:#23262f;
  --text-primary:#e6e8ee;
  --text-secondary:#9aa1b4;
  --text-dim:#5c6274;
  --accent:#d9a441;
  --accent-strong:#f0c169;
  --accent-soft:rgba(217,164,65,.14);
  --data:#5fd0d6;
  --data-soft:rgba(95,208,214,.14);
  --danger:#e5534b;
  --danger-soft:rgba(229,83,75,.14);
  --success:#4caf7d;
  --success-soft:rgba(76,175,125,.14);
  --mono:ui-monospace,"SF Mono","Cascadia Code","Consolas","Roboto Mono",monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --radius:6px;
  --topbar-h:44px;
  --statusbar-h:26px;
  --activitybar-w:48px;
  --sidebar-w:270px;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;background:var(--bg-app);color:var(--text-primary);
  font-family:var(--sans);font-size:13px;overflow:hidden;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--accent-soft);color:var(--accent-strong);}
::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#33384500;border-radius:5px;background:#383d4a;}
::-webkit-scrollbar-thumb:hover{background:#454b5c;}
button{font-family:inherit;}

/* ---------- App shell ---------- */
#app{display:flex;flex-direction:column;height:100vh;}

/* ---------- Top bar ---------- */
#topbar{
  height:var(--topbar-h);flex:0 0 auto;display:flex;align-items:center;
  gap:10px;padding:0 12px;background:var(--bg-panel);border-bottom:1px solid var(--border);
}
#topbar .brand{display:flex;align-items:center;gap:8px;font-weight:600;letter-spacing:.2px;color:var(--text-primary);padding-right:10px;border-right:1px solid var(--border);}
#topbar .brand .seal{
  width:20px;height:20px;border-radius:50%;
  background:conic-gradient(from 220deg, var(--accent), var(--accent-strong), var(--accent));
  box-shadow:0 0 0 2px #0000, 0 0 8px var(--accent-soft);
  display:flex;align-items:center;justify-content:center;font-size:10px;color:#241a05;font-weight:800;
}
#topbar .filename{color:var(--text-secondary);font-family:var(--mono);font-size:12px;}
#topbar .filename b{color:var(--text-primary);font-weight:600;}
#topbar .dirty-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);display:none;margin-left:4px;}
.status-badge{display:none;align-items:center;gap:6px;font-size:11.5px;padding:3px 9px;border-radius:20px;font-weight:600;}
.status-badge.show{display:inline-flex;}
.status-badge .dot{width:7px;height:7px;border-radius:50%;}
.status-badge.modified{background:var(--accent-soft);color:var(--accent-strong);}
.status-badge.modified .dot{background:var(--accent);}
.status-badge.saved{background:var(--success-soft);color:var(--success);}
.status-badge.saved .dot{background:var(--success);}
#topbar .spacer{flex:1;}
.topbtn{
  display:flex;align-items:center;gap:6px;background:var(--bg-elevated);color:var(--text-primary);
  border:1px solid var(--border);padding:6px 12px;border-radius:var(--radius);cursor:pointer;font-size:12.5px;
  transition:background .12s,border-color .12s;
}
.topbtn:hover{background:var(--bg-hover);border-color:#3a3f4d;}
.topbtn.primary{background:var(--accent-soft);border-color:var(--accent);color:var(--accent-strong);}
.topbtn.primary:hover{background:rgba(217,164,65,.24);}
.topbtn:disabled{opacity:.4;cursor:not-allowed;}

/* ---------- Body layout ---------- */
#body{flex:1;display:flex;min-height:0;}

/* ---------- Activity bar ---------- */
#activitybar{
  width:var(--activitybar-w);flex:0 0 auto;background:var(--bg-panel);
  border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;
  padding-top:8px;gap:2px;
}
.abtn{
  width:36px;height:36px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;
  color:var(--text-dim);cursor:pointer;position:relative;font-size:17px;background:transparent;border:none;
}
.abtn:hover{color:var(--text-primary);background:var(--bg-hover);}
.abtn.active{color:var(--accent-strong);background:var(--accent-soft);}
.abtn.active::before{content:"";position:absolute;left:-9px;top:6px;bottom:6px;width:2px;background:var(--accent);border-radius:2px;}
.abtn .tip{
  position:absolute;left:44px;top:50%;transform:translateY(-50%);background:#0d0f14;color:var(--text-primary);
  padding:4px 8px;border-radius:4px;font-size:11px;white-space:nowrap;border:1px solid var(--border);
  opacity:0;pointer-events:none;transition:opacity .1s;z-index:50;
}
.abtn:hover .tip{opacity:1;}

/* ---------- Sidebar ---------- */
#sidebar{
  width:var(--sidebar-w);flex:0 0 auto;background:var(--bg-panel);border-right:1px solid var(--border);
  display:flex;flex-direction:column;min-width:180px;max-width:480px;
}
#sidebar .sb-head{
  padding:10px 12px 6px;font-size:11px;letter-spacing:.08em;color:var(--text-dim);
  text-transform:uppercase;display:flex;align-items:center;justify-content:space-between;
}
#sidebar .sb-head .actions{display:flex;gap:4px;}
.icnbtn{
  width:22px;height:22px;border-radius:4px;background:transparent;border:none;color:var(--text-secondary);
  display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;
}
.icnbtn:hover{background:var(--bg-hover);color:var(--text-primary);}

#filetree{flex:1;overflow-y:auto;padding:2px 0 10px;}
.dropzone{
  margin:8px 10px;border:1.5px dashed var(--border);border-radius:var(--radius);
  padding:16px 10px;text-align:center;color:var(--text-dim);font-size:11.5px;cursor:pointer;
  transition:border-color .12s,color .12s,background .12s;
}
.dropzone:hover,.dropzone.dragover{border-color:var(--accent);color:var(--accent-strong);background:var(--accent-soft);}

.frow{
  display:flex;align-items:center;gap:6px;padding:5px 10px 5px 14px;cursor:pointer;color:var(--text-secondary);
  border-left:2px solid transparent;font-size:12.5px;user-select:none;
}
.frow:hover{background:var(--bg-hover);color:var(--text-primary);}
.frow.selected{background:var(--bg-elevated);color:var(--text-primary);border-left-color:var(--accent);}
.frow.dragover-target{background:var(--accent-soft);outline:1px dashed var(--accent);outline-offset:-1px;}
.frow.dragging{opacity:.4;}
.frow .chevron{width:12px;flex:0 0 auto;font-size:9px;color:var(--text-dim);text-align:center;transition:transform .1s;}
.frow .chevron.collapsed{transform:rotate(-90deg);}
.frow .chevron.spacer{visibility:hidden;}
.frow .ficon{width:15px;text-align:center;flex:0 0 auto;font-size:12px;color:var(--data);}
.frow.folder .ficon{color:var(--accent);}
.frow .fname{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--mono);}
.frow .fname-input{
  flex:1;background:var(--bg-input);border:1px solid var(--accent);color:var(--text-primary);
  font-family:var(--mono);font-size:12px;padding:2px 4px;border-radius:3px;outline:none;
}
.frow .fsize{color:var(--text-dim);font-size:10.5px;flex:0 0 auto;}
.frow .frowactions{display:flex;gap:2px;opacity:0;flex:0 0 auto;}
.frow:hover .frowactions{opacity:1;}
.frow .fact{color:var(--text-dim);width:18px;text-align:center;border-radius:3px;font-size:11px;}
.frow .fact:hover{background:var(--bg-app);color:var(--text-primary);}
.frow .fact.fdel:hover{color:var(--danger);}
.sb-empty{padding:16px 14px;color:var(--text-dim);font-size:12px;line-height:1.6;}
#filetree.root-dragover{outline:1px dashed var(--accent);outline-offset:-3px;background:var(--accent-soft);}

/* ---------- Main / editor area ---------- */
#main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg-app);}
#tabbar{
  flex:0 0 auto;display:flex;background:var(--bg-panel);border-bottom:1px solid var(--border);
  overflow-x:auto;min-height:36px;
}
.tab{
  display:flex;align-items:center;gap:8px;padding:0 12px;height:36px;border-right:1px solid var(--border);
  color:var(--text-secondary);cursor:pointer;font-size:12.5px;white-space:nowrap;background:transparent;
  border-top:2px solid transparent;
}
.tab:hover{color:var(--text-primary);}
.tab.active{color:var(--text-primary);background:var(--bg-app);border-top-color:var(--accent);}
.tab .ticon{font-size:12px;color:var(--data);}
.tab .tclose{color:var(--text-dim);width:16px;text-align:center;border-radius:3px;}
.tab .tclose:hover{background:var(--bg-hover);color:var(--danger);}

#panelhost{flex:1;overflow-y:auto;padding:22px 28px 60px;}
.panel{max-width:920px;margin:0 auto;display:none;}
.panel.active{display:block;animation:fadein .12s ease-out;}
@keyframes fadein{from{opacity:0;transform:translateY(2px);}to{opacity:1;transform:none;}}

.panel h1{font-size:16px;font-weight:600;margin:0 0 4px;color:var(--text-primary);}
.panel .sub{color:var(--text-dim);font-size:12px;margin:0 0 22px;}
.panel h2{font-size:11.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-dim);margin:26px 0 10px;}
.panel h2:first-of-type{margin-top:0;}

.card{background:var(--bg-panel);border:1px solid var(--border);border-radius:8px;padding:16px 18px;}
.card + .card{margin-top:10px;}

.field{margin-bottom:14px;}
.field:last-child{margin-bottom:0;}
.field label{display:block;font-size:11.5px;color:var(--text-secondary);margin-bottom:5px;}
.field .hint{font-size:11px;color:var(--text-dim);margin-top:5px;line-height:1.5;}
input[type=text],input[type=password],select,textarea{
  width:100%;background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);
  padding:8px 10px;border-radius:var(--radius);font-size:12.5px;font-family:var(--sans);outline:none;
  transition:border-color .12s;
}
input[type=text]:focus,input[type=password]:focus,select:focus,textarea:focus{border-color:var(--accent);}
textarea{resize:vertical;min-height:64px;font-family:var(--sans);}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.mono{font-family:var(--mono) !important;}

/* Header / hex-style table */
table.kv{width:100%;border-collapse:collapse;font-size:12.5px;}
table.kv tr{border-bottom:1px solid var(--border-soft);}
table.kv tr:last-child{border-bottom:none;}
table.kv td{padding:8px 6px;vertical-align:top;}
table.kv td.k{color:var(--text-dim);width:190px;font-size:11.5px;}
table.kv td.v{font-family:var(--mono);color:var(--text-primary);}
.badge{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:20px;font-size:11px;font-family:var(--sans);}
.badge.on{background:var(--success-soft);color:var(--success);}
.badge.off{background:var(--bg-hover);color:var(--text-dim);}
.badge.lock{background:var(--accent-soft);color:var(--accent-strong);}
.badge.data{background:var(--data-soft);color:var(--data);}

/* File table */
table.ftbl{width:100%;border-collapse:collapse;font-size:12px;}
table.ftbl thead th{
  text-align:left;color:var(--text-dim);font-weight:500;font-size:10.5px;text-transform:uppercase;
  letter-spacing:.05em;padding:8px 10px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg-panel);
}
table.ftbl tbody td{padding:8px 10px;border-bottom:1px solid var(--border-soft);font-family:var(--mono);color:var(--text-secondary);}
table.ftbl tbody tr:hover td{color:var(--text-primary);}
table.ftbl td.path{color:var(--text-primary);}
table.ftbl td.hash{font-size:10.5px;color:var(--text-dim);}
table.ftbl td.hash:hover{color:var(--data);}

/* Structure visualization — hierarchy tree */
.struct-tree{font-family:var(--mono);font-size:12.5px;}
.struct-node{display:flex;align-items:center;gap:8px;padding:6px 4px;border-radius:4px;}
.struct-node:hover{background:var(--bg-hover);}
.struct-node .sicon{
  width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;
  font-size:11px;flex:0 0 auto;color:#0d0f14;font-weight:700;
}
.struct-node .slabel{color:var(--text-primary);}
.struct-node .smeta{color:var(--text-dim);font-size:11px;margin-left:auto;}
.struct-branch{position:relative;margin-left:19px;padding-left:16px;border-left:1px dashed var(--border);}

/* Structure visualization — byte bar */
.structure-bar{display:flex;width:100%;height:54px;border-radius:8px;overflow:hidden;border:1px solid var(--border);}
.structure-seg{
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  border-right:1px solid var(--bg-app);font-size:10px;color:#1a1200;font-weight:700;min-width:2px;
  cursor:default;
}
.structure-seg:last-child{border-right:none;}
.structure-seg small{font-weight:500;font-size:9px;opacity:.75;}
.structure-legend{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px;}
.leg-item{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-secondary);}
.leg-swatch{width:11px;height:11px;border-radius:3px;flex:0 0 auto;}
.chunklist{margin-top:18px;display:flex;flex-direction:column;gap:8px;}
.chunkrow{
  display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--bg-panel);
  border:1px solid var(--border);border-radius:var(--radius);
}
.chunkrow .ctag{
  font-family:var(--mono);font-size:11px;font-weight:700;width:56px;flex:0 0 auto;padding:3px 0;
  text-align:center;border-radius:4px;
}
.chunkrow .cmeta{flex:1;font-size:11.5px;color:var(--text-secondary);}
.chunkrow .cbytes{font-family:var(--mono);font-size:11px;color:var(--text-dim);}

/* Buttons generic */
.btn{
  background:var(--bg-elevated);border:1px solid var(--border);color:var(--text-primary);
  padding:8px 14px;border-radius:var(--radius);font-size:12.5px;cursor:pointer;
}
.btn:hover{background:var(--bg-hover);}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#241a05;font-weight:600;}
.btn.primary:hover{background:var(--accent-strong);}
.btn.danger{background:var(--danger-soft);border-color:var(--danger);color:var(--danger);}
.btn.danger:hover{background:rgba(229,83,75,.24);}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.btnrow{display:flex;gap:8px;margin-top:16px;}

.empty-state{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  height:100%;min-height:340px;text-align:center;color:var(--text-dim);gap:14px;
}
.empty-state .seal-lg{
  width:64px;height:64px;border-radius:50%;
  background:conic-gradient(from 220deg, var(--accent), var(--accent-strong), var(--accent));
  box-shadow:0 0 30px var(--accent-soft);
}
.empty-state h1{color:var(--text-secondary);font-size:15px;}
.empty-state p{max-width:360px;font-size:12px;line-height:1.6;}

/* Preview panel */
.previewbox{
  background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius);
  padding:14px;font-family:var(--mono);font-size:12px;color:var(--text-secondary);
  white-space:pre-wrap;word-break:break-all;max-height:360px;overflow:auto;
}

/* Toast */
#toasthost{position:fixed;bottom:36px;right:16px;display:flex;flex-direction:column;gap:8px;z-index:200;}
.toast{
  background:var(--bg-elevated);border:1px solid var(--border);border-left:3px solid var(--accent);
  padding:10px 14px;border-radius:6px;font-size:12.5px;color:var(--text-primary);box-shadow:0 8px 24px rgba(0,0,0,.4);
  min-width:220px;animation:slidein .15s ease-out;
}
.toast.err{border-left-color:var(--danger);}
.toast.ok{border-left-color:var(--success);}
@keyframes slidein{from{transform:translateX(12px);opacity:0;}to{transform:none;opacity:1;}}

/* Status bar */
#statusbar{
  height:var(--statusbar-h);flex:0 0 auto;background:var(--accent);color:#241a05;display:flex;align-items:center;
  padding:0 12px;font-size:11px;gap:16px;font-weight:600;
}
#statusbar.locked{background:#3a3f4d;color:var(--text-secondary);}
#statusbar span{display:flex;align-items:center;gap:5px;}
#statusbar .spacer{flex:1;}

/* Modal */
.modal-backdrop{
  position:fixed;inset:0;background:rgba(6,7,10,.6);display:none;align-items:center;justify-content:center;z-index:100;
  backdrop-filter:blur(1px);
}
.modal-backdrop.show{display:flex;}
.modal{
  width:420px;max-width:92vw;background:var(--bg-panel);border:1px solid var(--border);border-radius:10px;
  padding:20px;box-shadow:0 24px 60px rgba(0,0,0,.5);
}
.modal h3{margin:0 0 4px;font-size:14.5px;}
.modal p.sub{margin:0 0 16px;color:var(--text-dim);font-size:11.5px;}
.modal .btnrow{justify-content:flex-end;}
.seg{display:flex;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
.seg button{
  flex:1;background:var(--bg-input);border:none;color:var(--text-secondary);padding:8px 0;cursor:pointer;font-size:12px;
}
.seg button.on{background:var(--accent-soft);color:var(--accent-strong);}
.seg button + button{border-left:1px solid var(--border);}

/* ======================================================================
   EXTENSION BLOCK — icons, search, context menu, settings, recents,
   stats, log panel, autosave badge, table totals. (added, nothing above
   this line was removed)
   ====================================================================== */

/* ---- CSS-drawn icons (no emoji) ---- */
.icon-search{position:relative;display:inline-block;width:12px;height:12px;}
.icon-search::before{content:"";position:absolute;left:0;top:0;width:9px;height:9px;border:1.6px solid currentColor;border-radius:50%;}
.icon-search::after{content:"";position:absolute;right:-1px;bottom:-1px;width:5px;height:1.6px;background:currentColor;transform:rotate(45deg);transform-origin:right center;}

.icon-settings{position:relative;display:inline-block;width:16px;height:14px;}
.icon-settings::before,.icon-settings::after{content:"";position:absolute;left:0;right:0;height:1.6px;background:currentColor;}
.icon-settings::before{top:2px;}
.icon-settings::after{bottom:2px;}
.icon-settings .isl{position:absolute;left:0;right:0;top:50%;height:1.6px;background:currentColor;transform:translateY(-50%);}
.icon-settings .knob{position:absolute;width:5px;height:5px;border-radius:50%;background:currentColor;top:-1.7px;}
.icon-settings .k1{left:2px;}
.icon-settings .k2{left:9px;top:4.3px;}
.icon-settings .k3{left:4px;top:10.3px;}

.icon-clock{position:relative;display:inline-block;width:14px;height:14px;border:1.6px solid currentColor;border-radius:50%;}
.icon-clock::before{content:"";position:absolute;left:50%;top:50%;width:1.4px;height:5px;background:currentColor;transform:translate(-50%,-100%);transform-origin:bottom center;}
.icon-clock::after{content:"";position:absolute;left:50%;top:50%;width:3.5px;height:1.4px;background:currentColor;transform:translate(0,-50%);transform-origin:left center;}

.icon-chart{position:relative;display:inline-flex;align-items:flex-end;gap:2px;width:14px;height:14px;}
.icon-chart span{display:block;width:3px;background:currentColor;border-radius:1px;}
.icon-chart span:nth-child(1){height:6px;}
.icon-chart span:nth-child(2){height:12px;}
.icon-chart span:nth-child(3){height:9px;}

.icon-log{position:relative;display:inline-block;width:14px;height:14px;}
.icon-log span{display:block;height:1.6px;background:currentColor;border-radius:1px;margin-bottom:2.5px;}
.icon-log span:nth-child(1){width:100%;}
.icon-log span:nth-child(2){width:70%;}
.icon-log span:nth-child(3){width:85%;}

.icon-audio-file{position:relative;display:inline-block;width:13px;height:13px;border-radius:50%;background:var(--data-soft);}
.icon-audio-file::before{content:"";position:absolute;left:4.5px;top:3px;width:0;height:0;border-style:solid;border-width:3.5px 0 3.5px 5px;border-color:transparent transparent transparent var(--data);}
.icon-image-file{position:relative;display:inline-block;width:14px;height:11px;border:1.4px solid var(--success);border-radius:2px;overflow:hidden;}
.icon-image-file::before{content:"";position:absolute;left:1.5px;top:1.5px;width:3px;height:3px;border-radius:50%;background:var(--success);}
.icon-image-file::after{content:"";position:absolute;right:-2px;bottom:-3px;width:11px;height:11px;background:var(--success);opacity:.55;transform:rotate(45deg);}
.icon-model-file{position:relative;display:inline-block;width:11px;height:11px;background:var(--accent);transform:rotate(45deg);border-radius:2px;}
.icon-folder{position:relative;display:inline-block;width:14px;height:11px;}
.icon-folder::before{content:"";position:absolute;left:0;top:0;width:6px;height:2.5px;background:currentColor;border-radius:1px 1px 0 0;}
.icon-folder::after{content:"";position:absolute;left:0;top:2px;width:14px;height:9px;background:currentColor;border-radius:1.5px;opacity:.9;}
.icon-keyboard{position:relative;display:inline-block;width:16px;height:12px;border:1.4px solid currentColor;border-radius:2px;}
.icon-keyboard i{position:absolute;width:2px;height:2px;background:currentColor;border-radius:.5px;top:3px;}
.icon-keyboard i:nth-child(1){left:2.5px;}
.icon-keyboard i:nth-child(2){left:7px;}
.icon-keyboard i:nth-child(3){left:11.5px;}
.icon-keyboard b{position:absolute;left:2.5px;right:2.5px;bottom:2px;height:1.6px;background:currentColor;border-radius:1px;}
.icon-book{position:relative;display:inline-block;width:14px;height:13px;}
.icon-book::before,.icon-book::after{content:"";position:absolute;top:0;width:6px;height:13px;border:1.4px solid currentColor;}
.icon-book::before{left:0;border-radius:3px 1px 1px 3px;border-right:none;}
.icon-book::after{right:0;border-radius:1px 3px 3px 1px;border-left:none;}

/* ---- Manual / tutorial accordion ---- */
.manual-section{background:var(--bg-panel);border:1px solid var(--border);border-radius:8px;margin-bottom:8px;overflow:hidden;}
.manual-section summary{
  padding:12px 16px;cursor:pointer;font-size:13px;font-weight:600;color:var(--text-primary);list-style:none;
  display:flex;align-items:center;justify-content:space-between;
}
.manual-section summary::-webkit-details-marker{display:none;}
.manual-section summary::after{content:"+";color:var(--text-dim);font-size:16px;font-weight:400;}
.manual-section[open] summary::after{content:"−";}
.manual-section summary:hover{background:var(--bg-hover);}
.manual-body{padding:2px 16px 16px;color:var(--text-secondary);font-size:12.5px;line-height:1.7;}
.manual-body ol,.manual-body ul{margin:6px 0;padding-left:20px;}
.manual-body li{margin-bottom:4px;}
.manual-body code{font-family:var(--mono);background:var(--bg-input);padding:1px 5px;border-radius:3px;font-size:11.5px;color:var(--accent-strong);}

/* ---- New Project modal — pending files ---- */
.pending-file-row{display:flex;align-items:center;gap:8px;padding:5px 8px;font-size:11.5px;color:var(--text-secondary);font-family:var(--mono);}
.pending-file-row .pf-remove{color:var(--text-dim);cursor:pointer;margin-left:auto;}
.pending-file-row .pf-remove:hover{color:var(--danger);}
.icon-command{position:relative;display:inline-block;width:14px;height:14px;}
.icon-command span{position:absolute;width:5.5px;height:5.5px;border:1.5px solid currentColor;border-radius:2.5px;}
.icon-command span:nth-child(1){left:0;top:0;}
.icon-command span:nth-child(2){right:0;top:0;}
.icon-command span:nth-child(3){left:0;bottom:0;}
.icon-command span:nth-child(4){right:0;bottom:0;}

/* ---- Explorer search ---- */
.search-wrap{position:relative;margin:2px 10px 6px;}
.search-wrap .icon-search{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:var(--text-dim);}
.search-input{
  width:100%;background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);
  padding:6px 8px 6px 26px;border-radius:5px;font-size:11.5px;outline:none;
}
.search-input:focus{border-color:var(--accent);}
.search-clear{
  position:absolute;right:6px;top:50%;transform:translateY(-50%);color:var(--text-dim);cursor:pointer;
  font-size:13px;width:16px;height:16px;display:none;align-items:center;justify-content:center;border-radius:3px;
}
.search-clear.show{display:flex;}
.search-clear:hover{background:var(--bg-hover);color:var(--text-primary);}
.frow .fname mark{background:var(--accent-soft);color:var(--accent-strong);border-radius:2px;}
.search-nomatch{padding:14px;color:var(--text-dim);font-size:11.5px;text-align:center;}

/* ---- Context menu ---- */
.ctxmenu{
  position:fixed;z-index:300;min-width:180px;background:var(--bg-elevated);border:1px solid var(--border);
  border-radius:8px;padding:5px;box-shadow:0 14px 36px rgba(0,0,0,.5);display:none;
}
.ctxmenu.show{display:block;}
.ctxmenu-item{
  padding:7px 10px;border-radius:5px;font-size:12.5px;color:var(--text-primary);cursor:pointer;
  display:flex;align-items:center;justify-content:space-between;
}
.ctxmenu-item:hover{background:var(--bg-hover);}
.ctxmenu-item.danger{color:var(--danger);}
.ctxmenu-item.danger:hover{background:var(--danger-soft);}
.ctxmenu-sep{height:1px;background:var(--border);margin:4px 2px;}

/* ---- Settings toggle switch ---- */
.toggle{position:relative;display:inline-block;width:34px;height:19px;flex:0 0 auto;}
.toggle input{opacity:0;width:0;height:0;}
.toggle .track{position:absolute;inset:0;background:var(--bg-input);border:1px solid var(--border);border-radius:20px;transition:.15s;cursor:pointer;}
.toggle .track::before{content:"";position:absolute;width:13px;height:13px;left:2px;top:2px;background:var(--text-dim);border-radius:50%;transition:.15s;}
.toggle input:checked + .track{background:var(--accent-soft);border-color:var(--accent);}
.toggle input:checked + .track::before{transform:translateX(15px);background:var(--accent);}
.field.row-inline{display:flex;align-items:center;justify-content:space-between;gap:12px;}
.field.row-inline label{margin:0;}

/* ---- Recent projects ---- */
.recent-item{
  display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--bg-panel);border:1px solid var(--border);
  border-radius:8px;
}
.recent-item + .recent-item{margin-top:8px;}
.recent-item .ricon{
  width:34px;height:34px;border-radius:8px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;
  color:var(--accent-strong);font-weight:700;font-family:var(--mono);font-size:12px;flex:0 0 auto;
}
.recent-item .rmain{flex:1;min-width:0;}
.recent-item .rname{color:var(--text-primary);font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.recent-item .rmeta{color:var(--text-dim);font-size:11px;margin-top:2px;font-family:var(--mono);}
.recent-item .ractions{display:flex;gap:6px;flex:0 0 auto;}

/* ---- Stats ---- */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.stat-tile{background:var(--bg-panel);border:1px solid var(--border);border-radius:8px;padding:14px;}
.stat-tile .stnum{font-size:20px;font-weight:700;color:var(--accent-strong);font-family:var(--mono);}
.stat-tile .stlabel{font-size:11px;color:var(--text-dim);margin-top:4px;}
.stat-bar-row{display:flex;align-items:center;gap:10px;padding:7px 0;}
.stat-bar-row .sblabel{width:90px;flex:0 0 auto;font-size:11.5px;color:var(--text-secondary);font-family:var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.stat-bar-track{flex:1;height:8px;background:var(--bg-input);border-radius:5px;overflow:hidden;}
.stat-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-strong));border-radius:5px;}
.stat-bar-row .sbval{width:64px;flex:0 0 auto;text-align:right;font-size:11px;color:var(--text-dim);font-family:var(--mono);}

/* ---- Log panel ---- */
.log-entry{display:flex;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border-soft);font-size:12px;align-items:flex-start;}
.log-entry:last-child{border-bottom:none;}
.log-time{color:var(--text-dim);font-family:var(--mono);font-size:10.5px;flex:0 0 auto;padding-top:1px;width:64px;}
.log-badge{flex:0 0 auto;font-size:9.5px;font-weight:700;padding:2px 6px;border-radius:4px;text-transform:uppercase;letter-spacing:.03em;}
.log-badge.info{background:var(--data-soft);color:var(--data);}
.log-badge.ok{background:var(--success-soft);color:var(--success);}
.log-badge.error{background:var(--danger-soft);color:var(--danger);}
.log-msg{flex:1;color:var(--text-secondary);line-height:1.5;}
.log-empty{padding:24px;text-align:center;color:var(--text-dim);font-size:12px;}

/* ---- Table footer totals ---- */
table.ftbl tfoot td{padding:9px 10px;font-family:var(--mono);font-size:11.5px;color:var(--text-dim);border-top:1px solid var(--border);background:var(--bg-panel);position:sticky;bottom:0;}
table.ftbl tfoot td b{color:var(--text-primary);}

/* ---- Autosave badge variant ---- */
.status-badge.autosaving{background:var(--data-soft);color:var(--data);}
.entry-check-row{display:flex;align-items:center;gap:10px;padding:7px 4px;border-bottom:1px solid var(--border-soft);font-size:12.5px;}
.entry-check-row:last-child{border-bottom:none;}
.entry-check-row .ecpath{flex:1;font-family:var(--mono);color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.entry-check-row.is-primary .ecpath{color:var(--accent-strong);font-weight:600;}
.entry-check-row .ecbadge{font-size:10px;color:var(--accent-strong);background:var(--accent-soft);padding:1px 7px;border-radius:10px;}
.previewbox.expanded{max-height:none;}
.sign-status{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:6px;font-size:12px;margin-top:8px;}
.sign-status.valid{background:var(--success-soft);color:var(--success);}
.sign-status.invalid{background:var(--danger-soft);color:var(--danger);}
.sign-status.none{background:var(--bg-input);color:var(--text-dim);}
/* ---- Command palette ---- */
.cmdpal-backdrop{position:fixed;inset:0;background:rgba(6,7,10,.55);display:none;align-items:flex-start;justify-content:center;z-index:400;padding-top:12vh;}
.cmdpal-backdrop.show{display:flex;}
.cmdpal{width:520px;max-width:92vw;background:var(--bg-elevated);border:1px solid var(--border);border-radius:10px;box-shadow:0 24px 60px rgba(0,0,0,.55);overflow:hidden;}
.cmdpal-input{width:100%;background:var(--bg-input);border:none;border-bottom:1px solid var(--border);color:var(--text-primary);padding:14px 16px;font-size:14px;outline:none;}
.cmdpal-list{max-height:340px;overflow-y:auto;padding:6px;}
.cmdpal-item{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-radius:6px;font-size:12.5px;color:var(--text-secondary);cursor:pointer;}
.cmdpal-item .cpi-key{font-family:var(--mono);font-size:10.5px;color:var(--text-dim);background:var(--bg-input);padding:2px 6px;border-radius:4px;border:1px solid var(--border);}
.cmdpal-item.active{background:var(--accent-soft);color:var(--text-primary);}
.cmdpal-empty{padding:20px;text-align:center;color:var(--text-dim);font-size:12px;}

/* ---- Shortcuts help modal ---- */
.shortcuts-grid{display:grid;grid-template-columns:1fr auto;gap:8px 14px;font-size:12.5px;}
.shortcuts-grid .sc-label{color:var(--text-secondary);}
.shortcuts-grid .sc-key{font-family:var(--mono);font-size:11px;color:var(--text-primary);background:var(--bg-input);padding:2px 8px;border-radius:4px;border:1px solid var(--border);white-space:nowrap;}

/* ---- Media preview (audio / image) ---- */
.media-preview{display:flex;align-items:center;justify-content:center;background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius);padding:18px;}
.media-preview img{max-width:100%;max-height:420px;border-radius:4px;}
.media-preview audio{width:100%;}

/* ---- Locked project banner ---- */
#lockedBanner{
  display:flex;align-items:center;gap:12px;padding:10px 20px;background:var(--danger-soft);border-bottom:1px solid var(--border);
  color:var(--danger);font-size:12.5px;
}
#lockedBanner .btn{padding:5px 12px;font-size:11.5px;}
.status-badge.autosaving .dot{background:var(--data);}

/* ---- Topbar icon-only button ---- */
.topbtn.icon-only{padding:6px 9px;}

/* ---- Explorer folder-drop-active (external OS files) ---- */
.frow.folder.filedrop-active{outline:1px solid var(--success);background:var(--success-soft);}
</style>
</head>
<body>
<div id="app">

  <!-- ================= TOP BAR ================= -->
  <div id="topbar">
    <div class="brand"><span class="seal">J</span> JNO Studio</div>
    <div class="filename" id="filenameDisplay">프로젝트 없음</div>
    <span class="status-badge" id="statusBadge"><span class="dot"></span><span id="statusBadgeText">Saved</span></span>
    <span class="status-badge autosaving" id="autosaveBadge" style="display:none;"><span class="dot"></span><span id="autosaveBadgeText">Autosave off</span></span>
    <div class="spacer"></div>
    <button class="topbtn icon-only" id="btnSettings" title="설정"><span class="icon-settings"><span class="isl"></span><span class="knob k1"></span><span class="knob k2"></span><span class="knob k3"></span></span></button>
    <button class="topbtn icon-only" id="btnShortcuts" title="단축키 (Shift + /)"><span class="icon-keyboard"><i></i><i></i><i></i><b></b></span></button>
    <button class="topbtn" id="btnNew">＋ New</button>
    <button class="topbtn" id="btnOpen">📂 Open .jno</button>
    <input type="file" id="fileOpenInput" accept=".jno" style="display:none">
    <button class="topbtn primary" id="btnSave" disabled>⤓ Save .jno</button>
  </div>

  <!-- ================= BODY ================= -->
  <div id="body">

    <!-- Activity bar -->
    <div id="activitybar">
      <button class="abtn active" data-panel="explorer" title="Explorer">🗂<span class="tip">Explorer</span></button>
      <button class="abtn" data-panel="manifest" title="Manifest">📋<span class="tip">Manifest</span></button>
      <button class="abtn" data-panel="header" title="Header">🔖<span class="tip">Header</span></button>
      <button class="abtn" data-panel="filetable" title="File Table">📊<span class="tip">File Table</span></button>
      <button class="abtn" data-panel="security" title="Security">🔒<span class="tip">Security</span></button>
      <button class="abtn" data-panel="structure" title="Structure">🧩<span class="tip">Structure</span></button>
      <button class="abtn" data-panel="recent" title="Recent Projects"><span class="icon-clock"></span><span class="tip">Recent Projects</span></button>
      <button class="abtn" data-panel="stats" title="Statistics"><span class="icon-chart"><span></span><span></span><span></span></span><span class="tip">Statistics</span></button>
      <button class="abtn" data-panel="log" title="Log"><span class="icon-log"><span></span><span></span><span></span></span><span class="tip">Log</span></button>
      <button class="abtn" data-panel="manual" title="매뉴얼 / 튜토리얼"><span class="icon-book"></span><span class="tip">매뉴얼 / 튜토리얼</span></button>
    </div>

    <!-- Sidebar (Explorer) -->
    <div id="sidebar">
      <div class="sb-head">
        <span>Explorer</span>
        <div class="actions">
          <button class="icnbtn" id="btnNewFile" title="새 파일">📄⁺</button>
          <button class="icnbtn" id="btnNewFolder" title="새 폴더">📁⁺</button>
          <button class="icnbtn" id="btnAddFile" title="파일 업로드">⬆</button>
        </div>
      </div>
      <div class="search-wrap">
        <span class="icon-search"></span>
        <input type="text" class="search-input" id="explorerSearch" placeholder="파일 및 폴더 검색">
        <span class="search-clear" id="explorerSearchClear">×</span>
      </div>
      <div id="filetree"></div>
      <input type="file" id="fileAddInput" multiple style="display:none">
    </div>

    <!-- Main -->
    <div id="main">
      <div id="tabbar"></div>
      <div id="lockedBanner" style="display:none;"></div>
      <div id="panelhost">

        <!-- Empty state (no project) -->
        <div class="panel active" id="panel-empty">
          <div class="empty-state">
            <div class="seal-lg"></div>
            <h1>열려 있는 JNO 프로젝트가 없습니다</h1>
            <p>새 프로젝트를 만들거나 기존 .jno 컨테이너를 열어서 구조를 확인·편집할 수 있습니다.</p>
            <div class="btnrow">
              <button class="btn primary" id="emptyNewBtn">새 프로젝트</button>
              <button class="btn" id="emptyOpenBtn">.jno 열기</button>
              <button class="btn" id="restoreAutosaveBtn" style="display:none;">자동 저장 데이터 복원</button>
            </div>
            <div class="btnrow">
              <button class="btn" id="emptyRecentBtn">최근 프로젝트 보기</button>
              <button class="btn" id="emptyDemoBtn">예제 프로젝트 둘러보기</button>
            </div>
          </div>
        </div>

        <!-- Manifest panel -->
        <div class="panel" id="panel-manifest">
          <h1>Manifest</h1>
          <p class="sub">프로젝트를 설명하는 메타데이터입니다. AI 및 도구가 이 정보를 통해 프로젝트를 빠르게 파악합니다.</p>
          <div class="card">
            <div class="row2">
              <div class="field"><label>Project Name</label><input type="text" id="mf-name" placeholder="my-project"><div class="hint" id="mf-name-err" style="color:var(--danger);display:none;">Project Name은 비워둘 수 없습니다.</div></div>
              <div class="field"><label>Version</label><input type="text" id="mf-version" placeholder="1.0.0"><div class="hint" id="mf-version-err" style="color:var(--danger);display:none;">권장 형식: MAJOR.MINOR.PATCH (예: 1.0.0)</div></div>
            </div>
            <div class="row2">
              <div class="field"><label>Author</label><input type="text" id="mf-author" placeholder="User"></div>
              <div class="field"><label>Language</label>
                <select id="mf-language">
                  <option>Python</option><option>HTML</option><option>CSS</option><option>JavaScript</option>
                  <option>C</option><option>C++</option><option>C#</option><option>JSON</option><option>XML</option>
                  <option>CSV</option><option>ONNX</option><option>Markdown</option><option>Other</option>
                </select>
              </div>
            </div>
            <div class="field"><label>Entry File</label><select id="mf-entry"></select><div class="hint" id="mf-entry-err" style="color:var(--accent-strong);display:none;">지정된 Entry File이 프로젝트에 존재하지 않습니다.</div></div>
            <div class="field"><label>Description (선택) <span class="hint" id="mf-desc-count" style="display:inline;">0/300</span></label><textarea id="mf-description" maxlength="300" placeholder="프로젝트에 대한 짧은 설명"></textarea></div>
            <div class="field hint">jno_spec_version: <b class="mono" id="mf-specver">1.0</b> · created_at: <span class="mono" id="mf-created">—</span></div>
          </div>
          <div class="btnrow"><button class="btn primary" id="mfSaveBtn">Manifest 저장</button></div>

          <h2>Entry Points (v2 — 다중 진입점)</h2>
          <p class="sub">위에서 지정한 Primary Entry 외에, 함께 실행 가능한 추가 진입점을 선택할 수 있습니다. manifest.entries 배열로 저장됩니다.</p>
          <div class="card">
            <div id="mf-entries-list"></div>
            <div class="hint" id="mf-entries-empty" style="display:none;">추가할 파일이 없습니다.</div>
          </div>

          <h2>AI 에이전트 지시사항 (v2 — AIIN 청크)</h2>
          <p class="sub">별도의 AIIN 청크에 저장되어, AI 도구가 이 프로젝트를 다룰 때 참고할 수 있는 지시사항입니다. Manifest와 동일한 보안 모드로 암호화됩니다.</p>
          <div class="card">
            <div class="field"><label>지시사항</label><textarea id="ai-instructions" placeholder="예: 이 프로젝트를 수정할 때는 항상 tests/를 먼저 실행하세요."></textarea></div>
            <div class="field"><label>우선순위 파일 (한 줄에 하나씩)</label><textarea id="ai-priority-files" placeholder="src/main.py&#10;README.md"></textarea></div>
            <div class="field"><label>제약사항 (한 줄에 하나씩)</label><textarea id="ai-constraints" placeholder="node_modules/는 수정하지 마세요"></textarea></div>
          </div>
          <div class="btnrow"><button class="btn primary" id="aiSaveBtn">AI 지시사항 저장</button></div>
        </div>

        <!-- Header panel -->
        <div class="panel" id="panel-header">
          <h1>Header</h1>
          <p class="sub">파일 최상단 32바이트 고정 헤더입니다. 매직 넘버, 버전, 플래그, 오프셋 정보를 담습니다.</p>
          <div class="card">
            <table class="kv" id="headerTable"></table>
          </div>
          <h2>편집 가능한 필드</h2>
          <div class="card">
            <div class="row2">
              <div class="field"><label>Version Major (고정)</label><input type="text" class="mono" value="1" disabled></div>
              <div class="field"><label>Version Minor</label><input type="text" class="mono" id="hdr-versionminor" placeholder="0"></div>
            </div>
            <div class="hint">Minor 버전은 동일한 major 규격 내에서 하위 호환 확장을 표시하는 데 사용됩니다. 숫자(0~255)만 입력하세요.</div>
            <div class="hint" id="hdr-fullenc-note" style="display:none;color:var(--danger);">Full Encryption 모드로 저장하면 이 헤더의 File Count가 0으로 기록되어, 비밀번호 없이는 파일 개수조차 알 수 없습니다.</div>
          </div>
        </div>

        <!-- File Table panel -->
        <div class="panel" id="panel-filetable">
